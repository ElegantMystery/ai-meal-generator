# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# PostgreSQL (local dev — matches docker-compose.yml service name)
DATABASE_URL=postgresql://meal_user:YOUR_DB_PASSWORD@mealgen-db:5432/mealgen
POSTGRES_PASSWORD=YOUR_DB_PASSWORD

# OpenAI (used only for embedding backfill — generation runs on Minimax)
OPENAI_API_KEY=sk-proj-...

# Minimax (Anthropic-compatible) — drives the agentic /generate loop
MINIMAX_API_KEY=
# Optional overrides — defaults shown
ANTHROPIC_BASE_URL=https://api.minimax.io/anthropic
AGENT_MODEL=MiniMax-M3
AGENT_MAX_TURNS=25

# Shared secret between backend and RAG service (generate a strong random value)
# RAG_ENV defaults to production; use development only for explicit local runs.
RAG_ENV=development
RAG_SHARED_SECRET=

# Google OAuth2 (get from Google Cloud Console > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe subscriptions (use test-mode values locally)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRO_PRICE_ID=price_...

# RAG tuning (optional — defaults shown)
EMBED_MODEL=text-embedding-3-small
BATCH_SIZE=128

# Spoonacular API (for recipe dataset import — get from spoonacular.com)
SPOONACULAR_API_KEY=
